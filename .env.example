# Copy to .env.local (development) or set in your hosting dashboard.
# Every value is optional: anything left empty stays hidden on the site.

# Production origin. Until this is set, the site sends noindex and robots.txt blocks crawlers.
NEXT_PUBLIC_SITE_URL=

# Public contact details (only publish verified business details)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits in international format, e.g. 9715XXXXXXXX. The WhatsApp button appears only when set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles (full URLs)
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_BEHANCE=

# Analytics. GA4 loads in production only, and only when set. Review consent requirements first.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Enquiry delivery (server-only secrets) ---
# Option A: POST each enquiry as JSON to a CRM / Make / Zapier / n8n webhook.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# Option B: email via Resend (https://resend.com). All three are required.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
# Local development only: log enquiries to the console instead of delivering them.
ENQUIRY_DEV_LOG=
